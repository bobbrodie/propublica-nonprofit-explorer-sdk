{
  "name": "propublica-nonprofit-explorer-sdk",
  "version": "4.0.3",
  "description": "SDK for ProPublica Nonprofit Explorer API",
  "main": "dist/index",
  "types": "dist/index",
  "exports": {
    ".": "./dist/index.js",
    "./constants": "./dist/constants/index.js",
    "./models": "./dist/models/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbrodie/propublica-nonprofit-explorer-sdk.git"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.json",
    "coverage": "npm run unit -- --coverage",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "npm run format && npm run lint && npm run coverage",
    "unit": "vitest run"
  },
  "keywords": [
    "nonprofit"
  ],
  "author": "Robert Brodie <rbrodie85@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20 <27"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix"
    ],
    "**/*": [
      "prettier --write ."
    ]
  }
}
